# Copy to .env and change these before any non-local deployment.
# docker compose reads .env automatically; .env is git-ignored.

# Database credentials (used by all three services).
POSTGRES_USER=festimize
POSTGRES_PASSWORD=festimize
POSTGRES_DB=festimize

# Shared secret the web app presents to the analytics API. Any long random
# string. The web app sends it as X-Analytics-Key; analytics rejects calls
# without it. Leave the default only for a throwaway local demo.
ANALYTICS_KEY=local-demo-key
